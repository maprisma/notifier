#!/usr/bin/env python3
"""Compile translations/<code>.json into src/translations_generated.rs (no other tools needed)."""
import json
from pathlib import Path
root = Path(__file__).resolve().parent.parent
catalogs = []
for code in 'en de fr es it pt nl pl'.split():
    table = json.loads((root / f'translations/{code}.json').read_text())
    catalogs.append('r###"' + json.dumps(table, ensure_ascii=False, sort_keys=True) + '"###')
(root / 'src/translations_generated.rs').write_text('// Generated by tools/gen-translations.\nconst CATALOG_JSON: [&str; 8] = [\n' + ',\n'.join(catalogs) + '\n];\n')
